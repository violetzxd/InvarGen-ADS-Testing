/* ============================================================================
 * INVARGEN Domain-Specific Language (DSL) Grammar
 * Defines the complete formal blueprint for Scenario Prototypes, including:
 * 1. Environment Topology
 * 2. Symbolic Parameter Spaces (for Fuzzing)
 * 3. Event Sequencing 
 * 4. Fixed-Point Oracles (based on LTL)
 * ============================================================================ */

/* --- 1. Root Structure --- */
<ScenarioBlueprint> ::= "SCENARIO_PROTOTYPE" <Identifier> "{"
                          <EnvironmentDef>
                          <ParticipantDef>
                          <EventSequence>
                          <FixedPointOracles>
                        "}"

/* --- 2. Data Types & Parameterization (Crucial for Fuzzing) --- */
<Value>             ::= <Float> | <Integer> | <SymbolicVar> | <SearchRange>
<SymbolicVar>       ::= "{" <Identifier> "}"   /* Instantiated by LLM based on context */
<SearchRange>       ::= "RANGE(" <Float> ", " <Float> ")" /* Fuzzing boundaries */
<Identifier>        ::= [a-zA-Z_][a-zA-Z0-9_]*

/* --- 3. Environment Context --- */
<EnvironmentDef>    ::= "ENVIRONMENT {"
                          "map: " <String>
                          "weather: " <WeatherType>
                          "friction_coeff: " <Value>
                        "}"
<WeatherType>       ::= "Clear" | "Rain" | "Fog" | "Snow" | "Wet_No_Rain"

/* --- 4. Participants (Defining the initial state space) --- */
<ParticipantDef>    ::= "PARTICIPANTS {" <EgoDef> <NPCDef>* "}"
<EgoDef>            ::= "EGO_VEHICLE {" 
                          "id: " <Identifier> 
                          "init_speed: " <Value> 
                          "init_lane: " <Integer> 
                        "}"
<NPCDef>            ::= "NPC_VEHICLE {" 
                          "id: " <Identifier> 
                          "type: " <VehicleClass>
                          "init_speed: " <Value> 
                          "init_lane: " <Integer> 
                          "longitudinal_offset: " <Value> /* E.g., RANGE(10.0, 30.0) */
                        "}"
<VehicleClass>      ::= "Sedan" | "SUV" | "Truck" | "Motorcycle" | "Bus"

/* --- 5. Event Sequence (Temporal Actions) --- */
<EventSequence>     ::= "STORYBOARD {" <StoryEvent>+ "}"
<StoryEvent>        ::= "EVENT " <Identifier> " {"
                          "actor: " <Identifier>
                          "trigger: " <TriggerCondition>
                          "action: " <ActionDef>
                        "}"
<TriggerCondition>  ::= "TIME > " <Value> 
                      | "DISTANCE(" <Identifier> ", " <Identifier> ") < " <Value>
                      | "TTC(" <Identifier> ", " <Identifier> ") < " <Value>

<ActionDef>         ::= "CutIn(duration=" <Value> ", target_lane=" <Integer> ")"
                      | "EmergencyBrake(target_speed=" <Value> ", deceleration=" <Value> ")"
                      | "Accelerate(target_speed=" <Value> ", duration=" <Value> ")"
                      | "MaintainKinematics()"

/* --- 6. Fixed Point Oracles (LTL-based Optimization Objectives) --- */
<FixedPointOracles> ::= "FIXED_POINTS {" <FixedPoint>+ "}"
<FixedPoint>        ::= <Category> ":" <Identifier> "{" <Monitor> "}"
<Category>          ::= "SAFETY" | "CRITICAL" | "RECOVERY"

<Monitor>           ::= <GlobalInvariant> | <EventDrivenAssertion>

/* LTL Global Operator (G) */
<GlobalInvariant>   ::= "INVARIANT_ALWAYS(" <Predicate> ")"

/* LTL Trigger & Eventually Operator (F) */
<EventDrivenAssertion> ::= "ON_EVENT(" <SystemTrigger> ") { ASSERT_EVENTUALLY(" <Predicate> ", within_time=" <Value> ") }"

<SystemTrigger>     ::= "lane_deviation_start(" <Identifier> ")"
                      | "emergency_braking_start(" <Identifier> ")"
                      | "collision_avoidance_triggered(" <Identifier> ")"

<Predicate>         ::= <Condition> | <Condition> " AND " <Predicate>
<Condition>         ::= <Function> " " <Operator> " " <Value>
                      | <BooleanFunc>

<Operator>          ::= ">" | "<" | ">=" | "<=" | "==" | "!="

<Function>          ::= "distance(" <Identifier> ", " <Identifier> ")"
                      | "speed(" <Identifier> ")"
                      | "TTC(" <Identifier> ", " <Identifier> ")"
                      | "abs(get_sideslip_angle(" <Identifier> "))"
                      | "lateral_deviation(" <Identifier> ")"

<BooleanFunc>       ::= "is_lane_centered(" <Identifier> ", tolerance=" <Value> ")"
                      | "is_stopped(" <Identifier> ")"

<String>            ::= '"' [^"]* '"'
<Float>             ::= [0-9]+ "." [0-9]+
<Integer>           ::= "-"? [0-9]+
